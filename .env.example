# ─── Facebook Page Manager — environment template ──────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit a filled-in `.env`.
#
# The Android app itself reads the Facebook App ID at BUILD time (see README:
# pass -PFACEBOOK_APP_ID=... to Gradle, or put facebook_app_id=... in
# local.properties). The variables below are for the optional FastAPI backend
# in ./backend, which handles server-side token exchange and webhooks.

# Meta Developer app credentials (https://developers.facebook.com/apps)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Used by the backend to verify webhook callbacks (you choose this value,
# then enter the same string in the Meta app dashboard under Webhooks).
WEBHOOK_VERIFY_TOKEN=

# Public HTTPS URL of the backend, e.g. https://fpm-api.example.com
# (Meta requires HTTPS for webhooks and OAuth redirects.)
BACKEND_PUBLIC_URL=

# Optional: restrict CORS to your own domains (comma-separated).
ALLOWED_ORIGINS=
